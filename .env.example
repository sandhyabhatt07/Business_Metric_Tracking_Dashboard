# Copy to .env and fill in. Never commit .env or the key file.

# Your Google Cloud project id (not the name).
GCP_PROJECT=your-project-id
BQ_LOCATION=US
BQ_RAW_DATASET=raw

# true while you use the free BigQuery sandbox (no billing account).
BQ_SANDBOX=true

# bigquery, or duckdb for a local warehouse file (data/warehouse.duckdb) that needs no GCP account.
PIPELINE_TARGET=bigquery

# Optional: pull real exchange rates from the Frankfurter API instead of the generated files.
# FX_SOURCE=https://api.frankfurter.dev/v1

# Linux only: run `echo "AIRFLOW_UID=$(id -u)" >> .env` so files written to data/ are yours.
